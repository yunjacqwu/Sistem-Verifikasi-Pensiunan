# Salin berkas ini menjadi .env di root project, lalu isi nilainya sendiri.
# Jangan commit berkas .env.

DB_HOST=localhost
DB_NAME=nama_database_anda
DB_USER=absensi_app
DB_PASS=isi_password_akun_database

# Kunci dasar enkripsi data pensiunan dan foto. Acak, minimal 32 karakter. Jangan diganti sembarangan.
AES_SECRET_KEY=isi_kunci_acak_panjang

# Kunci HMAC untuk rantai audit. Acak, minimal 32 karakter. Jangan diganti sembarangan.
AUDIT_HMAC_KEY=isi_kunci_acak_minimal_32_karakter
