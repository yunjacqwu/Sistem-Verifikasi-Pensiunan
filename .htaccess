# Apache 2.4 access control for sensitive environment files

# F-05 6B-3Q: tidak menampilkan listing folder tanpa index
Options -Indexes

# F-05 6B-3Q: blokir ekstensi SQL dan Markdown (huruf besar dan kecil)
<FilesMatch "\.[sS][qQ][lL]$">
    Require all denied
</FilesMatch>
<FilesMatch "\.[mM][dD]$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.env(?:\..*)?$">
    Require all denied
</FilesMatch>

# Force HTTPS for non-local hosts. Local XAMPP development remains usable over HTTP.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # F-05 6B-3Q: blokir folder internal dan arsip (403). Harus sebelum aturan HTTPS di bawah.
    RewriteRule ^(\.git|\.codebase-memory|\.claude|config|backup|backup_stage2_[^/]+|database|includes|admin/includes)(/|$) - [F,L,NC]

    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# Baseline browser security headers; CSP is set in config/bootstrap.php.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(self), microphone=()"
</IfModule>
